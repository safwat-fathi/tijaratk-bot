# General
PROJECT_NAME=TijaratkBot
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database
DB_URL=postgresql://user:password@localhost:5432/dbname

# AI - OpenRouter serves both chat/LLM and embeddings (bge-m3). All of these are REQUIRED (no defaults).
# NOTE: LLM_MODEL may be a `~vendor/model-latest` route; those stream even with stream=false (handled).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
CONTEXT_HISTORY_TURNS=10
LLM_MODEL=
LLM_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

REDIS_URL=redis://localhost:6379/0

# Channels / webhooks
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
PUBLIC_API_URL=
ZERNIO_RETURN_URL=http://localhost:3000/merchant/settings
ZERNIO_WEBHOOK_SECRET=
# Optional: our own Meta app saved in Zernio (GET /v1/connect/oauth-apps). Empty = Zernio's app.
ZERNIO_OAUTH_APP_ID=


# Auth
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# Minutes without human activity before the AI resumes a conversation a human took over
HUMAN_TAKEOVER_IDLE_MINUTES=30
FREE_PLAN_MONTHLY_CONVERSATIONS=10

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_DEFAULT_WINDOW=60
