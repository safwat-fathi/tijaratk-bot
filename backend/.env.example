# General
PROJECT_NAME="TijaratkBot"

CORS_ORIGINS=["http://localhost:3000"]

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="tijaratk_bot"
POSTGRES_PORT=5432

# AI Tiers
# OPENROUTER_API_KEY is used for both the DeepSeek engine (chat completions)
# and embeddings (bge-m3) below.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
DEEPSEEK_MODEL="~deepseek/deepseek-v4-flash-latest"

EMBEDDING_BASE_URL="https://openrouter.ai/api/v1"
EMBEDDING_API_KEY=""  # same value as OPENROUTER_API_KEY
EMBEDDING_MODEL="baai/bge-m3"

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
CONTEXT_HISTORY_TURNS=10
DEEPSEEK_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
SQL_ECHO=false

REDIS_URL="redis://localhost:6379/0"

# Channel/Webhook Settings
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
TWILIO_AUTH_TOKEN=""
TWILIO_WEBHOOK_URL=""

# Auth Settings
JWT_SECRET_KEY=""
ENCRYPTION_KEY=""

# Rate Limiting Settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEMO_MAX=10
RATE_LIMIT_DEMO_WINDOW=600
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_DEFAULT_WINDOW=60
