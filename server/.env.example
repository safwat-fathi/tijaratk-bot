# General
PROJECT_NAME=TijaratkBot
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database - either a full URL, or the POSTGRES_* parts
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tijaratk
POSTGRES_PORT=5432

# AI - OpenRouter serves both chat (DeepSeek) and embeddings (bge-m3). All of these are REQUIRED (no defaults).
# NOTE: DEEPSEEK_MODEL may be a `~vendor/model-latest` route; those stream even with stream=false (handled).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
DEEPSEEK_MODEL=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
CONTEXT_HISTORY_TURNS=10
DEEPSEEK_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

REDIS_URL=redis://localhost:6379/0

# Channels / webhooks
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=

# Auth
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEMO_MAX=10
RATE_LIMIT_DEMO_WINDOW=600
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_DEFAULT_WINDOW=60
