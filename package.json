{
  "name": "tijaratk-bot",
  "version": "0.1.0",
  "private": true,
  "description": "TijaratkBot root workspace runner for backend and frontend scripts",
  "scripts": {
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "pnpm --dir backend build",
    "build:be": "pnpm run build:backend",
    "build:frontend": "pnpm --dir frontend build",
    "build:fe": "pnpm run build:frontend",
    "dev": "pnpm run dev:frontend",
    "dev:backend": "pnpm --dir backend start:dev",
    "dev:be": "pnpm run dev:backend",
    "dev:worker": "pnpm --dir backend worker:dev",
    "worker:dev": "pnpm run dev:worker",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:fe": "pnpm run dev:frontend",
    "dev:all": "pnpm run dev:backend & pnpm run dev:frontend",
    "start": "pnpm run start:backend",
    "start:backend": "pnpm --dir backend start",
    "start:be": "pnpm run start:backend",
    "start:prod": "pnpm --dir backend start:prod",
    "start:worker": "pnpm --dir backend start:worker",
    "start:frontend": "pnpm --dir frontend start",
    "start:fe": "pnpm run start:frontend",
    "lint": "pnpm run lint:backend && pnpm run lint:frontend",
    "lint:backend": "pnpm --dir backend lint",
    "lint:be": "pnpm run lint:backend",
    "lint:frontend": "pnpm --dir frontend lint",
    "lint:fe": "pnpm run lint:frontend",
    "test": "pnpm --dir backend test",
    "test:backend": "pnpm --dir backend test",
    "test:be": "pnpm run test:backend",
    "test:watch": "pnpm --dir backend test:watch",
    "test:cov": "pnpm --dir backend test:cov",
    "test:debug": "pnpm --dir backend test:debug",
    "test:e2e": "pnpm --dir backend test:e2e",
    "typecheck": "pnpm --dir backend typecheck",
    "typecheck:backend": "pnpm --dir backend typecheck",
    "typecheck:be": "pnpm run typecheck:backend",
    "format": "pnpm --dir backend format",
    "format:backend": "pnpm --dir backend format",
    "format:be": "pnpm run format:backend",
    "db:migrate": "pnpm --dir backend db:migrate",
    "merchant:key": "pnpm --dir backend merchant:key"
  }
}
